# Used for canonical metadata and absolute links.
NEXT_PUBLIC_SITE_URL=https://www.tigershetty.com

# Optional: enables authenticated POST /api/revalidate requests. Generate a long,
# random value and send it in an Authorization: Bearer header. Never put it in a URL.
REVALIDATE_SECRET=

# Optional: live "on rotation" tracks for the About page vinyl player.
# Create a Spotify app, then run `node scripts/spotify-auth.mjs` once locally
# to mint the refresh token (scope: user-top-read). Without these the player
# falls back to the curated playlist embed.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
