# The app talks to a provider-neutral adapter. beehiiv is the Phase 1 default.
NEWSLETTER_PROVIDER=beehiiv
NEWSLETTER_API_KEY=
# For beehiiv, this is the Publication ID.
NEWSLETTER_AUDIENCE_ID=

# Generate a long random value and store it only in Vercel/local .env files.
RESOURCE_DOWNLOAD_SECRET=

# Local-only switch for testing the complete signup and download journey.
RESOURCE_SIGNUP_PREVIEW=false

# Used for canonical metadata and absolute links.
NEXT_PUBLIC_SITE_URL=https://shettysdesk.vercel.app
